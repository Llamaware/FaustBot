# Generated by install.sh from faustbot.service.template; edit the template, not the installed copy.
[Unit]
Description=FaustBot - Discord VPN Monitor
After=network-online.target vpnserver.service
Wants=network-online.target

[Service]
# The bot tells systemd when it has started, so "systemctl restart" waits for it.
Type=notify
User=@USER@
WorkingDirectory=@DIR@
ExecStart=@DIR@/FaustBot

# Restart after a crash, but not after /bot shutdown (exit 0) or a config error (exit 78).
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78

# /bot restart exits with 75: treat it as a clean exit, but restart anyway.
SuccessExitStatus=75
RestartForceExitStatus=75

[Install]
WantedBy=multi-user.target
